import { Error as IoError, println } from "std/io";

import * as counting from "study/algorithms/counting";
import * as graphs from "study/algorithms/graphs";
import * as sorting from "study/algorithms/sorting";
import * as structures from "study/algorithms/structures";

fn sortingSmoke(): bool {
  let insertionValues = arrayOf(5, -1, 5, 3, 0);
  sorting.insertionSort(insertionValues);
  let heapValues = arrayOf(9, 4, 7, 1, -2, 6, 5);
  sorting.heapSort(heapValues);
  return insertionValues[0] == -1
    && insertionValues[1] == 0
    && insertionValues[4] == 5
    && heapValues[0] == -2
    && heapValues[6] == 9;
}

fn structuresSmoke(): bool {
  const stack = structures.newStack();
  stack.push(10);
  stack.push(20);
  stack.push(30);
  const stackValue = match stack.pop() {
    Some(value) => value,
    None => {
      return false;
    },
  };
  const queue = structures.newQueue();
  queue.enqueue(10);
  queue.enqueue(20);
  queue.enqueue(30);
  const queueValue = match queue.dequeue() {
    Some(value) => value,
    None => {
      return false;
    },
  };
  const heap = structures.newMinHeap();
  heap.push(7);
  heap.push(2);
  heap.push(9);
  heap.push(1);
  const minimum = match heap.pop() {
    Some(value) => value,
    None => {
      return false;
    },
  };
  const dsu = structures.newDsu(5);
  dsu.union(0, 1);
  dsu.union(1, 2);
  dsu.union(3, 4);
  return stackValue == 30
    && stack.length() == 2
    && queueValue == 10
    && queue.length() == 2
    && minimum == 1
    && dsu.connected(0, 2)
    && !dsu.connected(0, 3)
    && dsu.components() == 2;
}

fn graphsSmoke(): bool {
  const adjacency: [][]int = [[1, 2], [0, 3], [0, 3], [1, 2]];
  const distances = match graphs.bfs(adjacency, 0) {
    Some(value) => value,
    None => {
      return false;
    },
  };
  const weighted: [][]graphs.Edge = [
    [graphs.edge(1, 4), graphs.edge(2, 1)],
    [graphs.edge(3, 1)],
    [graphs.edge(1, 2), graphs.edge(3, 5)],
    [],
  ];
  const shortest = match graphs.dijkstra(weighted, 0) {
    Some(value) => value,
    None => {
      return false;
    },
  };
  return distances[3] == 2 && shortest[1] == 3 && shortest[3] == 4;
}

fn countingSmoke(): bool {
  const values = arrayOf(2, 1, 2, 3, 1, 2);
  const counts = counting.intFrequencies(values);
  const twos = match counts.get(2) {
    Some(value) => value,
    None => 0,
  };
  return twos == 3 && counts.length() == 3 && counting.uniqueIntCount(values) == 3;
}

fn main(): Result<void, IoError> {
  if !sortingSmoke() || !structuresSmoke() || !graphsSmoke() || !countingSmoke() {
    panic("Marimay algorithms smoke test failed");
  }
  println("Marimay algorithms: ok")?;
  return Ok();
}
