import * as graphs from "study/algorithms/graphs";
import * as sorting from "study/algorithms/sorting";
import * as structures from "study/algorithms/structures";

fn addChecksum(checksum: int, value: int): int {
  const modulus = 1_000_000_007;
  let normalized = value % modulus;
  if normalized < 0 {
    normalized += modulus;
  }
  return (checksum + normalized) % modulus;
}

fn generatedValues(size: int, seed: int): []int {
  let values: []int = [];
  let state = seed;
  for index in 0..size {
    state = (state * 25173 + 13849) % 65536;
    const _ = values.push(state % 20001 - 10000);
  }
  return values;
}

public fn benchmarkInsertion(): int {
  let checksum = 0;
  for repeat in 0..50 {
    let values = generatedValues(2500, repeat + 1);
    sorting.insertionSort(values);
    checksum = addChecksum(checksum, values[0]);
    checksum = addChecksum(checksum, values[values.length() / 2]);
    checksum = addChecksum(checksum, values[values.length() - 1]);
  }
  return checksum;
}

public fn benchmarkHeapSort(): int {
  let checksum = 0;
  for repeat in 0..5 {
    let values = generatedValues(100_000, repeat + 101);
    sorting.heapSort(values);
    checksum = addChecksum(checksum, values[0]);
    checksum = addChecksum(checksum, values[values.length() / 2]);
    checksum = addChecksum(checksum, values[values.length() - 1]);
  }
  return checksum;
}

public fn benchmarkStack(): int {
  const stack = structures.newStack();
  let state = 7;
  for index in 0..1_000_000 {
    state = (state * 25173 + 13849) % 65536;
    stack.push(state % 1001);
  }
  let checksum = 0;
  while !stack.empty() {
    const value = match stack.pop() {
      Some(current) => current,
      None => panic("non-empty stack returned None"),
    };
    checksum = addChecksum(checksum, value);
  }
  return checksum;
}

public fn benchmarkQueue(): int {
  const queue = structures.newQueue();
  let state = 11;
  for index in 0..1_000_000 {
    state = (state * 25173 + 13849) % 65536;
    queue.enqueue(state % 1001);
  }
  let checksum = 0;
  while !queue.empty() {
    const value = match queue.dequeue() {
      Some(current) => current,
      None => panic("non-empty queue returned None"),
    };
    checksum = addChecksum(checksum, value);
  }
  return checksum;
}

public fn benchmarkMinHeap(): int {
  const heap = structures.newMinHeap();
  let state = 13;
  for index in 0..500_000 {
    state = (state * 25173 + 13849) % 65536;
    heap.push(state % 10001);
  }
  let checksum = 0;
  while !heap.empty() {
    const value = match heap.pop() {
      Some(current) => current,
      None => panic("non-empty heap returned None"),
    };
    checksum = addChecksum(checksum, value);
  }
  return checksum;
}

public fn benchmarkDsu(): int {
  const size = 100_000;
  const dsu = structures.newDsu(size);
  for operation in 0..5_000_000 {
    const left = operation % size;
    const right = (operation * 17 + 3) % size;
    dsu.union(left, right);
  }
  let checksum = dsu.components();
  let index = 0;
  while index < size {
    checksum = addChecksum(checksum, dsu.find(index));
    index += 97;
  }
  return checksum;
}

public fn benchmarkBfs(): int {
  const size = 20_000;
  let adjacency: [][]int = [];
  for node in 0..size {
    const _ = adjacency.push(
      [(node + 1) % size, (node + size - 1) % size, (node + 7) % size, (node + size - 7) % size],
    );
  }
  let checksum = 0;
  for repeat in 0..300 {
    const distances = match graphs.bfs(adjacency, repeat) {
      Some(values) => values,
      None => panic("valid BFS graph rejected"),
    };
    checksum = addChecksum(checksum, distances[(repeat + size / 2) % size]);
    checksum = addChecksum(checksum, distances[(repeat + size / 3) % size]);
  }
  return checksum;
}

public fn benchmarkDijkstra(): int {
  const size = 800;
  let adjacency: [][]graphs.Edge = [];
  for node in 0..size {
    let edges: []graphs.Edge = [];
    if node + 1 < size {
      const _ = edges.push(graphs.edge(node + 1, 1));
    }
    if node + 7 < size {
      const _ = edges.push(graphs.edge(node + 7, 3));
    }
    const _ = adjacency.push(edges);
  }
  let checksum = 0;
  for repeat in 0..80 {
    const distances = match graphs.dijkstra(adjacency, repeat) {
      Some(values) => values,
      None => panic("valid Dijkstra graph rejected"),
    };
    checksum = addChecksum(checksum, distances[size - 1]);
    checksum = addChecksum(checksum, distances[size / 2]);
  }
  return checksum;
}
