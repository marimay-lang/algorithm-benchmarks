fn addChecksum(checksum: int, value: int): int {
  const modulus = 1_000_000_007;
  let normalized = value % modulus;
  if normalized < 0 {
    normalized += modulus;
  }
  return (checksum + normalized) % modulus;
}

fn scalarValues(size: int): []int {
  let values: []int = [];
  const _ = values.reserve(size);
  for index in 0..size {
    const _ = values.push((index * 17 + 3) % 1009);
  }
  return values;
}

fn denseValues(size: int): []int {
  let values: []int = [];
  const _ = values.reserve(size);
  for index in 0..size {
    const _ = values.push(index % 251);
  }
  return values;
}

public fn probeScalarGet(): int {
  const size = 4096;
  const values = scalarValues(size);
  let checksum = 0;
  for iteration in 0..4_000_000 {
    const index = (iteration * 17 + 3) % size;
    checksum = addChecksum(checksum, values[index]);
  }
  return checksum;
}

public fn probeScalarSet(): int {
  const size = 4096;
  let values: []int = [];
  const _ = values.reserve(size);
  for index in 0..size {
    const _ = values.push(0);
  }
  for iteration in 0..4_000_000 {
    const index = (iteration * 17 + 3) % size;
    values[index] = iteration % 1009;
  }
  let checksum = 0;
  for value in values {
    checksum = addChecksum(checksum, value);
  }
  return checksum;
}

public fn probeProvenBounds(): int {
  const values = denseValues(262_144);
  let checksum = 0;
  for repeat in 0..32 {
    for index in 0..values.length() {
      checksum = addChecksum(checksum, values[index] % 251);
    }
  }
  return checksum;
}

public fn probeUnprovenBounds(): int {
  const size = 262_144;
  const values = denseValues(size);
  let checksum = 0;
  for iteration in 0..8_000_000 {
    const index = (iteration * 17 + 3) % size;
    checksum = addChecksum(checksum, values[index] % 251);
  }
  return checksum;
}

fn growthChecksum(reserved: bool): int {
  const size = 1_000_000;
  let values: []int = [];
  if reserved {
    const _ = values.reserve(size);
  }
  for index in 0..size {
    const _ = values.push(index % 251);
  }
  let checksum = 0;
  let index = 0;
  while index < size {
    checksum = addChecksum(checksum, values[index]);
    index += 997;
  }
  return checksum;
}

public fn probeGrowth(): int {
  return growthChecksum(false);
}

public fn probeReservedGrowth(): int {
  return growthChecksum(true);
}

public fn probeDensity(): int {
  const values = denseValues(1_000_000);
  let checksum = 0;
  for repeat in 0..12 {
    for index in 0..values.length() {
      checksum = addChecksum(checksum, values[index] % 251);
    }
  }
  return checksum;
}

public fn probeNestedTraversal(): int {
  const rowCount = 2048;
  const columnCount = 256;
  let rows: [][]int = [];
  const _ = rows.reserve(rowCount);
  for rowIndex in 0..rowCount {
    let row: []int = [];
    const _ = row.reserve(columnCount);
    for columnIndex in 0..columnCount {
      const _ = row.push((rowIndex * columnCount + columnIndex) % 251);
    }
    const _ = rows.push(row);
  }
  let checksum = 0;
  for repeat in 0..12 {
    for rowIndex in 0..rows.length() {
      const row = rows[rowIndex];
      for columnIndex in 0..row.length() {
        checksum = addChecksum(checksum, row[columnIndex]);
      }
    }
  }
  return checksum;
}

public fn probeCheckedLoop(): int {
  let state = 7;
  let checksum = 0;
  for iteration in 0..20_000_000 {
    state = (state * 25173 + 13849) % 65536;
    checksum = addChecksum(checksum, state % 1009);
  }
  return checksum;
}
