{
  "schema": "ruda.algorithm-equivalence/1",
  "languages": [
    "ruda",
    "go",
    "rust"
  ],
  "generator": {
    "kind": "lcg",
    "state_initialization": "workload seed",
    "step": "state = (state * 25173 + 13849) % 65536",
    "multiplier": 25173,
    "increment": 13849,
    "modulus": 65536
  },
  "checksum": {
    "modulus": 1000000007,
    "normalization": "each selected signed value is reduced modulo 1000000007 and made non-negative before addition",
    "stdout": "{id} {checksum}\n"
  },
  "measurement": {
    "includes": [
      "process startup",
      "input construction",
      "reusable API calls",
      "selected-result validation",
      "checksum calculation",
      "one stdout line"
    ],
    "excludes": [
      "compilation",
      "ruda run and VM execution",
      "debug-runtime archive measurements",
      "invalid-input probes"
    ]
  },
  "invalid_input_policy": {
    "timed_workloads": "all timed inputs satisfy the reusable API preconditions",
    "correctness_tests": "out-of-range starts/endpoints and negative Dijkstra weights are rejected in every language; signed negative indices are additionally tested where the host type admits them",
    "language_boundary": "Rust graph indices use usize, so a negative index is unrepresentable rather than accepted"
  },
  "global_source_contracts": {
    "ruda": {
      "path": "ruda/benchmarks/core/benchmarks.ruda",
      "required_fragments": [
        "import * as graphs from \"study/algorithms/graphs\";",
        "import * as sorting from \"study/algorithms/sorting\";",
        "import * as structures from \"study/algorithms/structures\";"
      ],
      "forbidden_fragments": [
        "type IntOption",
        "type SearchResult",
        "sizeValue:",
        "targets:",
        "weights:",
        "fn insertionSort(",
        "fn heapSort("
      ]
    },
    "go": {
      "path": "go/cmd/benchmark/main.go",
      "required_fragments": [
        "example.com/ruda-algorithms/graphs",
        "example.com/ruda-algorithms/sorting",
        "example.com/ruda-algorithms/structures"
      ],
      "forbidden_fragments": [
        "func insertionSort(",
        "func heapSort(",
        "type IntOption",
        "type SearchResult"
      ]
    },
    "rust": {
      "path": "rust/src/bin/benchmark.rs",
      "required_fragments": [
        "use ruda_algorithms::graphs::{self, Edge};",
        "use ruda_algorithms::sorting;",
        "use ruda_algorithms::structures::{Dsu, MinHeap, Queue, Stack};"
      ],
      "forbidden_fragments": [
        "fn insertion_sort(",
        "fn heap_sort(",
        "struct IntOption",
        "struct SearchResult"
      ]
    }
  },
  "workloads": [
    {
      "id": "insertion",
      "description": "50 × 2,500 generated integers",
      "expected_checksum": 999956059,
      "input": "for repeat 0..49 generate 2,500 values with seed repeat + 1; map state to state % 20001 - 10000",
      "operations": "call reusable insertion sort once per generated array",
      "representation": "one contiguous logical array of signed integers",
      "checks": "checksum the first, middle, and last sorted values after every call",
      "implementations": {
        "ruda": {
          "required_fragments": [
            "repeat < 50",
            "generatedValues(2500, repeat + 1)",
            "sorting.insertionSort(values);"
          ]
        },
        "go": {
          "required_fragments": [
            "repeat < 50",
            "generatedValues(2500, repeat+1)",
            "sorting.InsertionSort(values)"
          ]
        },
        "rust": {
          "required_fragments": [
            "for repeat in 0..50",
            "generated_values(2_500, repeat + 1)",
            "sorting::insertion_sort(&mut values);"
          ]
        }
      }
    },
    {
      "id": "heap-sort",
      "description": "5 × 100,000 generated integers",
      "expected_checksum": 999995320,
      "input": "for repeat 0..4 generate 100,000 values with seed repeat + 101; map state to state % 20001 - 10000",
      "operations": "call reusable in-place binary heap sort once per generated array",
      "representation": "one contiguous logical array of signed integers",
      "checks": "checksum the first, middle, and last sorted values after every call",
      "implementations": {
        "ruda": {
          "required_fragments": [
            "repeat < 5",
            "generatedValues(100_000, repeat + 101)",
            "sorting.heapSort(values);"
          ]
        },
        "go": {
          "required_fragments": [
            "repeat < 5",
            "generatedValues(100_000, repeat+101)",
            "sorting.HeapSort(values)"
          ]
        },
        "rust": {
          "required_fragments": [
            "for repeat in 0..5",
            "generated_values(100_000, repeat + 101)",
            "sorting::heap_sort(&mut values);"
          ]
        }
      }
    },
    {
      "id": "stack",
      "description": "1,000,000 push + pop",
      "expected_checksum": 498055372,
      "input": "generate 1,000,000 values from seed 7 and map state to state % 1001",
      "operations": "push every value through the reusable stack API, then pop until empty",
      "representation": "package-owned stack over one growable signed-integer array with no shadow logical size",
      "checks": "checksum every value in LIFO removal order",
      "implementations": {
        "ruda": {
          "required_fragments": [
            "index < 1_000_000",
            "structures.newStack()",
            "stack.push(state % 1001);",
            "stack.pop()"
          ]
        },
        "go": {
          "required_fragments": [
            "index < 1_000_000",
            "structures.NewStack()",
            "stack.Push(state % 1001)",
            "stack.Pop()"
          ]
        },
        "rust": {
          "required_fragments": [
            "for _ in 0..1_000_000",
            "Stack::new()",
            "stack.push(state % 1_001);",
            "stack.pop()"
          ]
        }
      }
    },
    {
      "id": "queue",
      "description": "1,000,000 enqueue + dequeue",
