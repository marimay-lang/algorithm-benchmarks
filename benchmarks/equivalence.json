            "heap.push(state % 10_001);",
            "heap.pop()"
          ]
        }
      }
    },
    {
      "id": "dsu",
      "description": "100,000 nodes; 5,000,000 unions",
      "expected_checksum": 21343152,
      "input": "create 100,000 singleton nodes; for operation 0..4,999,999 union operation % size with (operation * 17 + 3) % size",
      "operations": "call reusable union by rank with path-compressing find for every union, then find every 97th node",
      "representation": "package-owned parent and rank arrays plus a component count",
      "checks": "start with the final component count and checksum every 97th representative",
      "implementations": {
        "ruda": {
          "required_fragments": [
            "const size = 100_000;",
            "operation < 5_000_000",
            "structures.newDsu(size)",
            "dsu.union(left, right);",
            "index += 97"
          ]
        },
        "go": {
          "required_fragments": [
            "const size = 100_000",
            "operation < 5_000_000",
            "structures.NewDSU(size)",
            "dsu.Union(left, right)",
            "index += 97"
          ]
        },
        "rust": {
          "required_fragments": [
            "const SIZE: usize = 100_000;",
            "for operation in 0..5_000_000",
            "Dsu::new(SIZE)",
            "dsu.union(left, right);",
            "step_by(97)"
          ]
        }
      }
    },
    {
      "id": "bfs",
      "description": "300 × 20,000 nodes, degree 4",
      "expected_checksum": 715800,
      "input": "create 20,000 nested adjacency arrays; each node links to ±1 and ±7 modulo size; run starts 0..299",
      "operations": "call reusable BFS for every start and traverse with a FIFO head index",
      "representation": "nested integer arrays with four neighbors per node; Option/pair reports invalid input",
      "checks": "checksum distances at (start + size / 2) % size and (start + size / 3) % size",
      "implementations": {
        "ruda": {
          "required_fragments": [
            "const size = 20_000;",
            "repeat < 300",
            "graphs.bfs(adjacency, repeat)",
            "(node + size - 7) % size"
          ]
        },
        "go": {
          "required_fragments": [
            "const size = 20_000",
            "repeat < 300",
            "graphs.BFS(adjacency, repeat)",
            "(node + size - 7) % size"
          ]
        },
        "rust": {
          "required_fragments": [
            "const SIZE: usize = 20_000;",
            "for repeat in 0..300",
            "graphs::bfs(&adjacency, repeat)",
            "(node + SIZE - 7) % SIZE"
          ]
        }
      }
    },
    {
      "id": "dijkstra",
      "description": "80 × 800 nodes, O(V²)",
      "expected_checksum": 38672,
      "input": "create 800 nested edge-record arrays with forward +1/weight 1 and +7/weight 3 edges where in range; run starts 0..79",
      "operations": "call reusable O(V²) Dijkstra for every start; each iteration linearly selects the unvisited minimum and relaxes its edge records",
      "representation": "nested arrays of records with target and signed weight fields; Option/pair reports invalid input",
      "checks": "checksum distances to node size - 1 and node size / 2",
      "implementations": {
        "ruda": {
          "required_fragments": [
            "const size = 800;",
            "repeat < 80",
            "let adjacency: [][]graphs.Edge = [];",
            "edges.push(graphs.edge(node + 7, 3));",
            "graphs.dijkstra(adjacency, repeat)"
          ]
        },
        "go": {
          "required_fragments": [
            "const size = 800",
            "repeat < 80",
            "make([][]graphs.Edge, size)",
            "graphs.Edge{To: node + 7, Weight: 3}",
            "graphs.Dijkstra(adjacency, repeat)"
          ]
        },
        "rust": {
          "required_fragments": [
            "const SIZE: usize = 800;",
            "for repeat in 0..80",
            "let adjacency: Vec<Vec<Edge>>",
            "weight: 3,",
            "graphs::dijkstra(&adjacency, repeat)"
          ]
        }
      }
    }
  ]
}
