            "queue.enqueue(state % 1_001);",
            "queue.dequeue()"
          ]
        }
      }
    },
    {
      "id": "min-heap",
      "description": "500,000 insert + remove-min",
      "expected_checksum": 405398755,
      "input": "generate 500,000 values from seed 13 and map state to state % 10001",
      "operations": "push every value through the reusable binary min-heap API, then pop until empty",
      "representation": "package-owned binary min-heap over one growable signed-integer array with no shadow logical size",
